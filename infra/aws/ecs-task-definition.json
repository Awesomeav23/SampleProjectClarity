{
  "_comment": "AWS ECS Fargate task definition — template for production deployment. Fill in account-specific values before use.",
  "family": "project-clarity-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/projectClarityTaskRole",
  "containerDefinitions": [
    {
      "name": "project-clarity-backend",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/project-clarity-backend:latest",
      "portMappings": [
        {
          "containerPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        { "name": "MOCK_MODE", "value": "false" },
        { "name": "NEW_RELIC_ENABLED", "value": "true" },
        { "name": "NEW_RELIC_APP_NAME", "value": "project-clarity-backend" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/database-url" },
        { "name": "REDIS_HOST", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/redis-host" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/jwt-secret" },
        { "name": "JOBDIVA_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/jobdiva-client-id" },
        { "name": "JOBDIVA_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/jobdiva-client-secret" },
        { "name": "DOCUSIGN_INTEGRATION_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/docusign-key" },
        { "name": "DOCUSIGN_ACCOUNT_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/docusign-account" },
        { "name": "SHAREPOINT_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/sharepoint-client-id" },
        { "name": "SHAREPOINT_TENANT_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/sharepoint-tenant" },
        { "name": "NEW_RELIC_LICENSE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:project-clarity/newrelic-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/project-clarity-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:4000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
