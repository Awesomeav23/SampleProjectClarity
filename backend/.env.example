PORT=4000

# ─── Mode ────────────────────────────────────────────────────────────────────
# Set to "true" to use mock clients, "false" to use real API credentials
MOCK_MODE=true

# ─── JobDiva API ─────────────────────────────────────────────────────────────
JOBDIVA_API_BASE_URL=https://api.jobdiva.com/v1
JOBDIVA_CLIENT_ID=
JOBDIVA_CLIENT_SECRET=
JOBDIVA_TENANT_ID=
# Request a sandbox from JobDiva support for dev/testing
JOBDIVA_SANDBOX=true

# ─── DocuSign API ────────────────────────────────────────────────────────────
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_REDIRECT_URI=http://localhost:4000/api/docusign/callback
# Use "demo" for sandbox, "production" for live
DOCUSIGN_ENVIRONMENT=demo

# ─── SharePoint Online (Microsoft Graph API) ────────────────────────────────
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://dynpro.sharepoint.com/sites/PMO
SHAREPOINT_DRIVE_ID=

# ─── Auth / Security ────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRY=8h
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER_URL=

# ─── Database (PostgreSQL via Docker) ────────────────────────────────────────
# Local dev: matches docker-compose.yml
DATABASE_URL=postgresql://clarity_user:clarity_local_pass@localhost:5434/project_clarity
# Production: use AWS RDS connection string from Secrets Manager

# ─── Redis (via Docker) ─────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6380
# Production: use AWS ElastiCache endpoint

# ─── BullMQ (uses Redis connection above) ───────────────────────────────────
# No additional config needed — BullMQ connects to the same Redis instance

# ─── New Relic Monitoring ───────────────────────────────────────────────────
# Disabled by default. Sign up at https://newrelic.com (free tier: 100GB/mo)
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=project-clarity-backend

# ─── Notifications ──────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@dynpro.com
